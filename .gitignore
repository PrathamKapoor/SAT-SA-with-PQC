# Local runtime artifacts (e.g. scripts/serve_ui.py's default db/keys) —
# generated data, never source. Any other *.db/*.sqlite* file is also
# always a local run's output (fixtures use pytest's tmp_path, never a
# committed file) — ignored generally rather than named one at a time.
satsa_ui.db
satsa_ui.db-shm
satsa_ui.db-wal
satsa_ui_keys/
.satsa_identity/
ci-smoke.db
ci-smoke-keys/
ci-demo.db
ci-demo-keys/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

