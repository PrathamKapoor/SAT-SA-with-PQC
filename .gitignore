.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.pyc
*.pyo
.coverage
.coverage.*
htmlcov/

# P28: setuptools/pip build byproducts (created in the repo root by
# `pip wheel .` / `python -m build` even when the output wheel itself
# is directed elsewhere) — never source, never intended to be tracked.
build/
*.egg-info/
dist/

# Environment / secrets — this project has none committed today, but
# any local override belongs here, never in git.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account.json
secrets.json

# Local runtime artifacts (e.g. scripts/serve_ui.py's default db/keys) —
# generated data, never source. Any other *.db/*.sqlite* file is also
# always a local run's output (fixtures use pytest's tmp_path, never a
# committed file) — ignored generally rather than named one at a time.
satsa_ui.db
satsa_ui.db-shm
satsa_ui.db-wal
satsa_ui_keys/
.satsa_identity/
ci-smoke.db
ci-smoke-keys/
ci-demo.db
ci-demo-keys/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Editor / OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# A1.2: SoftHSM2 development provider binaries
# These are downloaded once for A1.2 real-provider certification and must
# not be committed to the repository.  Bootstrap them via:
#   powershell -ExecutionPolicy Bypass -File scripts/bootstrap_softhsm2.ps1
.devtools/softhsm2/bin/
.devtools/softhsm2/lib/
.devtools/softhsm2/share/
.devtools/softhsm2/etc/
.devtools/softhsm2/README.txt

# P28 release: SAT-SA-with-PQC/ is a separate, complete nested git clone
# of this project's own GitHub repository (has its own .git/), used for
# local push verification. It is not a submodule, not a dependency, and
# not source belonging to this repository. This single, narrow rule only
# prevents an accidental future `git add`/`git add -A` from attempting to
# track it as nested content — it does not remove, move, or otherwise
# touch the existing clone on disk. Its disposition (keep, relocate
# outside the project root, or delete) is the repository owner's call.
SAT-SA-with-PQC/
