.vscode/
.idea/
.DS_Store
Thumbs.db

# A1.2: SoftHSM2 development provider binaries
# These are downloaded once for A1.2 real-provider certification and must
# not be committed to the repository.  Bootstrap them via:
#   powershell -ExecutionPolicy Bypass -File scripts/bootstrap_softhsm2.ps1
.devtools/softhsm2/bin/
.devtools/softhsm2/lib/
.devtools/softhsm2/share/
.devtools/softhsm2/etc/
.devtools/softhsm2/README.txt
