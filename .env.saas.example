# Copy to .env.saas and supply a unique URL-safe alphanumeric secret of at
# least 32 characters. Do not commit real credentials.
SATSA_POSTGRES_PASSWORD=replace_with_64_random_hex_characters
SATSA_S3_ACCESS_KEY=replace_with_local_test_access_key
SATSA_S3_SECRET_KEY=replace_with_local_test_secret_key
SATSA_S3_BUCKET=satsa-private
SATSA_S3_ENDPOINT_URL=http://objectstore:8333
SATSA_S3_REGION=us-east-1
SATSA_S3_USE_SSL=false
SATSA_S3_ADDRESSING_STYLE=path
SATSA_STORAGE_BACKEND=s3
SATSA_AUTO_MIGRATE=false
SATSA_ALLOWED_HOSTS=localhost,127.0.0.1
SATSA_ALLOWED_ORIGINS=
SATSA_API_PORT_PUBLIC=8000
