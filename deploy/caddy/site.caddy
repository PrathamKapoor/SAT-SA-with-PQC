# Public site: the only published entry point. TLS is automatic: a public DNS
# name gets a certificate from Let's Encrypt; "localhost" uses Caddy's local CA.
{$SATSA_SITE_ADDRESS} {$SATSA_SITE_ALIASES} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Everything is served from this origin (fonts are self-hosted at build
		# time). Next.js hydration uses inline scripts and styles, so those stay
		# 'unsafe-inline'; the policy still blocks third-party scripts, outbound
		# connections, framing, <base> rewriting and cross-origin form posts.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
		-X-Powered-By
	}

	# Pages carry tenant data rendered for one session: no shared or browser
	# cache may keep them. Only content-hashed build assets are cacheable.
	@dynamic not path /_next/static/*
	header @dynamic >Cache-Control "no-store"

	# Evidence uploads pass through the web tier to the API (17 MiB limit there).
	# max_size applies only while an upstream reads the body, so a declared
	# body of 19 MB or more is refused here before any tier touches it.
	@oversized header_regexp Content-Length ^([0-9]{9,}|19[0-9]{6}|[2-9][0-9]{7})$
	respond @oversized 413
	request_body {
		max_size 18MB
	}

	# Caddy replaces any client-supplied X-Forwarded-For with the real peer
	# address; the web tier forwards only that value to the API.
	reverse_proxy web:3000
}
