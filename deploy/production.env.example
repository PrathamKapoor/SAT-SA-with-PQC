# SAT-SA production settings. Copy to deploy/production.env on the host,
# fill in every value, and keep the file readable only by the deploying user
# (chmod 600). deploy/production.env is ignored by git; never commit it.

# Public hostname whose DNS A/AAAA record points at this host. Caddy obtains
# the HTTPS certificate for it automatically (ports 80 and 443 must be open).
SATSA_SITE_ADDRESS=satsa.example.org

# PostgreSQL password: URL-safe characters only (it is embedded in a URL).
# Generate with: openssl rand -hex 32
SATSA_POSTGRES_PASSWORD=

# S3-compatible object storage for uploaded evidence (HTTPS endpoint).
# With deploy/compose.objectstore.yml the endpoint is set for you and the
# access key and secret below become the bundled store's credentials.
SATSA_S3_ENDPOINT_URL=https://objects.example.org
SATSA_S3_REGION=us-east-1
SATSA_S3_BUCKET=satsa-evidence
SATSA_S3_ACCESS_KEY=
SATSA_S3_SECRET_KEY=
SATSA_S3_ADDRESSING_STYLE=auto

# Optional
# SATSA_S3_PREFIX=
# SATSA_DB_POOL_MAX_SIZE=10
# SATSA_LOG_LEVEL=INFO
# SATSA_IMAGE_TAG=local
